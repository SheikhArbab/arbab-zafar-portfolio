    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "nodemailer": "^7.0.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.2",
    "@tailwindcss/vite": "^4.3.5",
