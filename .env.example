# ─────────────────────────────────────────────────────────────────────
#  Copy to .env (local) and set the same keys in Netlify → Site settings
#  → Environment variables (production).
# ─────────────────────────────────────────────────────────────────────

# ── PUBLIC: bundled into the browser (safe by design; protected by RLS) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: Cloudflare Turnstile site key for the contact form
VITE_TURNSTILE_SITE_KEY=

# ── SERVER-ONLY: used by Netlify Functions. NEVER prefix with VITE_ ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Random string used to hash visitor IPs for rate limiting (privacy)
IP_HASH_SALT=change-me-to-a-long-random-string
# Netlify build hook (Site settings → Build & deploy → Build hooks) for “Publish SEO build”
NETLIFY_BUILD_HOOK_URL=
# Optional: Cloudflare Turnstile secret (pairs with VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=
# ── Contact-form email notifications (pick ONE provider) ──
# Recipient is set in Admin → Messages → Email notifications (CONTACT_NOTIFY_EMAIL is a fallback).
# Option A, Gmail (easiest): GMAIL_USER = your Gmail, GMAIL_APP_PASSWORD = a 16-char Google App password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B, any SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Option C, Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_NOTIFY_EMAIL=

# ── BUILD ──
# Canonical URL used in sitemap / canonical tags (overrides the admin SEO setting)
SITE_URL=https://arbab-dev.netlify.app
